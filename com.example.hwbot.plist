<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.hwbot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>-u</string>
    <string>/ABSOLUTE/PATH/TO/hw_bot.py</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/TO</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/TO/bot.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/TO/bot.log</string>
</dict>
</plist>
